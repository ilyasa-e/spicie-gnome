#!/usr/bin/env -S gjs -m
/**
 * Spicie - Standalone Lyrics Window
 * High-performance 60 FPS millisecond karaoke overlay using GTK4, Cairo, and Pango.
 * Packaged and managed directly by the GNOME Shell Extension.
 */

import Gtk from 'gi://Gtk?version=4.0';
import Gdk from 'gi://Gdk?version=4.0';
import Pango from 'gi://Pango?version=1.0';
import PangoCairo from 'gi://PangoCairo?version=1.0';
import GLib from 'gi://GLib';
import Gio from 'gi://Gio';
import GioUnix from 'gi://GioUnix';
import Cairo from 'cairo';
import System from 'system';
import { KaraokeLayout } from '../karaokeLayout.js';
import { activeLineIndex, lyricStartTime } from '../karaokeTiming.js';

import { SpotifyMPRIS } from '../mpris.js';
import { LyricsProvider } from '../lyricsProvider.js';
import { fetchTrackLyrics } from '../lyricsRequest.js';
import { lyricAttribution, attributionMarkup, requiresVisibleAttribution } from '../lyricsAttribution.js';
import { lineAlignment } from '../lyricsPresentation.js';
import { treatsMessageAsLyrics } from '../hudLifecycle.js';
import { floatingFrame, countdownDots, LyricRowMotion } from '../lyricsView.js';
import { pangoFont } from '../fontWeight.js';

// Load X11 surface methods when available. Wayland-only GTK builds do not need
// this namespace; the extension hides their windows through the compositor.
try {
    imports.gi.versions.GdkX11 = '4.0';
    void imports.gi.GdkX11;
} catch (_) {}

// GdkSurface.set_input_region() does not accept null from JavaScript. Passing
// it threw inside 'activate', before stdin and the fallback clock were wired,
// so the window stayed blank. An oversized rectangle restores full input; the
// compositor clips it to the surface.
export function inputRegion(passthrough) {
    const region = new Cairo.Region();
    if (!passthrough) region.unionRectangle({x: 0, y: 0, width: 0x7fff, height: 0x7fff});
    return region;
}

export class FloatingLyricsHUDApp {
    constructor() {
        this._app = new Gtk.Application({
            application_id: 'dev.norang.SpotifyFloatingLyricsHUD',
            // The extension owns exactly one window and kills it on disable.
            // Uniqueness made a respawn silently exit while a stale instance
            // still owned the application id, leaving no visible lyrics.
            flags: Gio.ApplicationFlags.NON_UNIQUE,
        });

        this._win = null;
        this._drawingArea = null;
        this._settings = null;

        // Lyrics & playback state
        this._lines = [];
        this._currentLineIndex = -1;
        this._playbackStatus = 'Stopped';
        this._basePositionMs = 0;
        this._playbackRate = 1;
        this._baseTimeUs = GLib.get_monotonic_time();
        this._trackTitle = '';
        this._trackArtist = '';
        this._hasStdinLyrics = false;
        this._requestGeneration = 0;
        this._mpris = null;
        this._lyricsProvider = null;

        // Cached layouts for performance
        this._activeLayout = null;
        this._romajiLayout = null;
        this._nextLayout = null;

        this._setupSettings();
        this._app.connect('activate', () => this._onActivate());
        this._app.connect('shutdown', () => this._shutdown());
    }

    _setupSettings() {
        try {
            const schemaId = 'org.gnome.shell.extensions.spotify-floating-lyrics';
            const defaultSource = Gio.SettingsSchemaSource.get_default();
            const localPath = Gio.File.new_for_uri(import.meta.url).get_parent().get_parent().get_child('schemas').get_path();
            let schema = null;
            if (GLib.file_test(GLib.build_filenamev([localPath, 'gschemas.compiled']), GLib.FileTest.EXISTS)) {
                schema = Gio.SettingsSchemaSource.new_from_directory(localPath, defaultSource, false).lookup(schemaId, false);
            }
            schema ||= defaultSource.lookup(schemaId, true);

            if (schema) {
                this._settings = new Gio.Settings({ settings_schema: schema });
                const keys = [
                    'font-family',
                    'font-weight',
                    'font-size',
                    'line-spacing',
                    'background-style',
                    'enable-romanization',
                    'floating-click-passthrough',
                    'floating-moving',
                    'animate-lyrics',
                    'lyrics-alignment',
                    'floating-line-count',
                    'show-countdown',
                    'enable-spicy-lyrics',
                    'spicy-lyrics-client-key'
                ];
                keys.forEach(k => {
                    this._settings.connect(`changed::${k}`, () => {
                        this._onSettingsChanged();
                        if (['enable-spicy-lyrics', 'spicy-lyrics-client-key', 'enable-romanization'].includes(k) && !this._hasStdinLyrics && this._mpris) this._loadTrack(this._mpris.track);
                    });
                });
            }
        } catch (e) {
            console.error('[HUD] Settings init error:', e.message);
        }
    }

    _onActivate() {
        if (this._win) {
            this._win.present();
            return;
        }

        this._win = new Gtk.ApplicationWindow({
            application: this._app,
            title: 'Spicie',
            default_width: 480,
            default_height: 90,
            decorated: false,
        });
        this._win.connect('realize', () => {
            // X11 hints are applied before mapping. Wayland uses the extension's
            // compositor-side window-list control instead.
            const surface = this._win.get_surface();
            surface?.set_skip_taskbar_hint?.(true);
            surface?.set_skip_pager_hint?.(true);
        });

        // Set transparent window background via CSS
        const cssProvider = new Gtk.CssProvider();
        cssProvider.load_from_data(`
            window, .background {
                background-color: transparent;
                background: transparent;
            }
            .source-credits { color: rgba(255,255,255,0.8); font-size: 10px; }
            .source-credits link { color: #b4dcff; }
        `, -1);
        Gtk.StyleContext.add_provider_for_display(
            this._win.get_display(),
            cssProvider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        );

        // Drawing Area for 60 FPS sub-pixel karaoke rendering
        this._drawingArea = new Gtk.DrawingArea();
        this._drawingArea.set_draw_func((area, cr, width, height) => {
            this._render(cr, width, height);
        });

        // Use the display clock. Timing remains in milliseconds; repainting
        // follows the monitor refresh rather than a millisecond timer.
        this._drawingArea.add_tick_callback(() => {
            const frame = this._viewFrame(this._getCurrentPositionMs());
            // Toggle the overlay label here, before layout. Changing its
            // visibility from the draw function snapshots it unallocated.
            const showCredits = this._showsCredits(frame);
            if (this._creditsLabel && this._creditsLabel.visible !== showCredits) this._creditsLabel.set_visible(showCredits);
            const animate = this._settings?.get_boolean('animate-lyrics') ?? true;
            const timed = frame.rows.some(row => row.state === 'active' && row.line.syllables?.length);
            if (this._frameSignature(frame) !== this._lastFrame ||
                this._rowMotion?.running(GLib.get_monotonic_time() / 1000) ||
                (this._playbackStatus === 'Playing' && ((animate && timed) || frame.filler)))
                this._drawingArea.queue_draw();
            return true;
        });

        // Drag to move window
        const clickGesture = new Gtk.GestureClick({ button: 1 });
        clickGesture.connect('pressed', (gesture, nPress, x, y) => {
            if (this._passthrough()) return;

            if (gesture.get_current_button() === 1) { // Left click
                const surface = this._win.get_surface();
                if (surface && typeof surface.begin_move === 'function') {
                    const device = gesture.get_device();
                    surface.begin_move(device, 1, x, y, gesture.get_current_event().get_time());
                }
            }
        });
        this._drawingArea.add_controller(clickGesture);

        const overlay = new Gtk.Overlay({ child: this._drawingArea });
        this._creditsLabel = new Gtk.Label({ use_markup: true, wrap: true,
            wrap_mode: Pango.WrapMode.WORD_CHAR, xalign: 0, halign: Gtk.Align.FILL,
            valign: Gtk.Align.END, margin_start: 16, margin_end: 16, margin_bottom: 8,
            css_classes: ['source-credits'], visible: false });
        overlay.add_overlay(this._creditsLabel);
        this._win.set_child(overlay);
        this._win.present();

        // Apply initial click passthrough
        this._applyClickPassthrough();

        // Start listening to stdin IPC
        this._startStdinReader();

        // Also attempt direct MPRIS fallback if running standalone
        this._initMPRISFallback();
    }

    _onSettingsChanged() {
        this._karaokeCache = null;
        this._karaokeLayouts = new Map();
        this._applyClickPassthrough();
        this._drawingArea?.set_cursor_from_name(this._passthrough() ? 'default' : 'move');
        if (this._drawingArea) {
            this._drawingArea.queue_draw();
        }
    }

    _applyClickPassthrough() {
        if (!this._win) return;
        const surface = this._win.get_surface();
        if (!surface || typeof surface.set_input_region !== 'function') return;

        surface.set_input_region(inputRegion(this._passthrough()));
    }

    // Moving overrides click-through without changing the saved preference,
    // so pressing Done restores exactly what the user had.
    _moving() {
        return this._settings?.get_boolean('floating-moving') ?? false;
    }

    _passthrough() {
        return (this._settings?.get_boolean('floating-click-passthrough') ?? false) && !this._moving();
    }

    _startStdinReader() {
        try {
            const stdinStream = new Gio.DataInputStream({
                base_stream: new GioUnix.InputStream({ fd: 0, close_fd: false })
            });

            const readNext = () => {
                stdinStream.read_line_async(GLib.PRIORITY_DEFAULT, null, (stream, res) => {
                    try {
                        const [line] = stream.read_line_finish_utf8(res);
                        if (line === null) {
                            // Extension exited or closed stdin -> cleanly exit HUD
                            this._app.quit();
                            return;
                        }
                        this._handleIPCMessage(line);
                        readNext();
                    } catch (e) {
                        this._app.quit();
                    }
                });
            };
            readNext();
        } catch (e) {
            console.error('[HUD] Stdin IPC init error:', e.message);
        }
    }

    _handleIPCMessage(rawJson) {
        try {
            const msg = JSON.parse(rawJson);
            if (!msg || !msg.type) return;
            if (!['lyrics', 'sync', 'exit'].includes(msg.type)) return;
            // Only actual lyric rows make the extension authoritative. A sync
            // alone, or an empty payload caused by a failed fetch, means the
            // window should keep (or start) its own fallback instead of going
            // blank until the setting is toggled.
            const hasLines = Array.isArray(msg.lines) && msg.lines.length > 0;
            if (treatsMessageAsLyrics(msg) && hasLines) {
                if (!this._hasStdinLyrics) this._lyricsProvider?.cancel();
                this._hasStdinLyrics = true;
                ++this._requestGeneration;
            } else if (treatsMessageAsLyrics(msg) && !msg.pending) {
                this._hasStdinLyrics = false;
            }

            switch (msg.type) {
                case 'lyrics':
                    this._rowMotion = null;
                    this._motionGeometry = null;
                    this._contentHeight = null;
                    this._lastDrawPosition = null;
                    this._lines = Array.isArray(msg.lines) ? msg.lines : [];
                    // The extension is still fetching the next song. Keep the
                    // window's size so it does not collapse and grow back.
                    this._pending = Boolean(msg.pending) && !hasLines;
                    this._setAttribution(this._lines.length ? msg.attribution || {provider:'Unknown source',contributors:[]} : null, msg.expiresAt);
                    this._trackTitle = msg.title || '';
                    this._trackArtist = msg.artist || '';
                    this._currentLineIndex = -1;
                    this._karaokeCache = null;
                this._karaokeLayouts = new Map();
                    break;

                case 'sync':
                    this._syncSeen = true;
                    this._playbackStatus = msg.status || 'Stopped';
                    this._basePositionMs = typeof msg.positionMs === 'number' ? msg.positionMs : 0;
                    this._baseTimeUs = Number.isFinite(msg.sampleTimeUs) ? msg.sampleTimeUs : GLib.get_monotonic_time();
                    this._playbackRate = Number(msg.rate) > 0 ? Number(msg.rate) : 1;
                    break;

                case 'exit':
                    this._app.quit();
                    break;
            }
            this._drawingArea?.queue_draw();
            if (treatsMessageAsLyrics(msg) && !hasLines && !msg.pending) {
                // The extension had nothing to show for this track. Recover
                // independently so the window is not blank for the song.
                const known = this._mpris?.track;
                const track = { ...(known || {}), title: msg.title || known?.title || '',
                    artist: msg.artist || known?.artist || '' };
                if (track.title) this._loadTrack(track);
            }
        } catch (e) {
            // Ignore malformed JSON line
        }
    }

    _initMPRISFallback() {
        this._requestGeneration = 0;
        this._mpris = new SpotifyMPRIS();
        this._lyricsProvider = new LyricsProvider();
        this._mpris.connect('track-changed', (_player, track) => {
            if (!this._hasStdinLyrics) this._loadTrack(track);
        });
        this._mpris.connect('status-changed', (_player, status) => {
            if (this._hasStdinLyrics) return;
            this._playbackStatus = status;
            this._drawingArea?.queue_draw();
        });
        this._mpris.connect('seeked', () => {
            if (!this._hasStdinLyrics) this._drawingArea?.queue_draw();
        });
        this._mpris.connect('player-available', (_player, available) => {
            if (!available && !this._hasStdinLyrics) this._loadTrack(null);
        });
        // Give the extension's initial messages a chance to arrive before
        // starting a second catalogue request in standalone mode.
        this._fallbackStart = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 150, () => {
            this._fallbackStart = 0;
            if (!this._hasStdinLyrics) this._loadTrack(this._mpris.track);
            return GLib.SOURCE_REMOVE;
        });
        this._clockRefresh = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 2000, () => {
            if (!this._hasStdinLyrics) this._mpris.refreshPosition();
            return GLib.SOURCE_CONTINUE;
        });
    }

    async _loadTrack(track, retried = false) {
        if (this._hasStdinLyrics) return;
        const generation = ++this._requestGeneration;
        this._lines = [];
        this._setAttribution(null);
        this._karaokeCache = null;
        this._karaokeLayouts = new Map();
        this._trackTitle = track?.title || '';
        this._trackArtist = track?.artist || '';
        this._playbackStatus = this._mpris.playbackStatus;
        this._drawingArea?.queue_draw();
        if (!track?.title) return;
        try {
            const result = await fetchTrackLyrics(this._lyricsProvider, track, this._settings);
            if (!result || generation !== this._requestGeneration || this._hasStdinLyrics) return;
            if (result.failed && !retried) {
                this._fallbackRetry = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 900, () => {
                    this._fallbackRetry = 0;
                    this._loadTrack(track, true);
                    return GLib.SOURCE_REMOVE;
                });
                return;
            }
            this._lines = result.lines || [];
            this._setAttribution(lyricAttribution(result), result.expiresAt);
            this._drawingArea?.queue_draw();
        } catch (e) {
            if (generation === this._requestGeneration) console.warn(`[Lyrics] ${e.message}`);
        }
    }

    _shutdown() {
        ++this._requestGeneration;
        if (this._fallbackStart) GLib.Source.remove(this._fallbackStart);
        if (this._clockRefresh) GLib.Source.remove(this._clockRefresh);
        if (this._heightUpdateId) GLib.Source.remove(this._heightUpdateId);
        if (this._fallbackRetry) GLib.Source.remove(this._fallbackRetry);
        if (this._lyricsExpiryId) GLib.Source.remove(this._lyricsExpiryId);
        this._lyricsProvider?.destroy();
        this._mpris?.destroy();
        this._drawingArea = null;
        this._win = null;
    }

    _getCurrentPositionMs() {
        // Lyrics from the extension without a clock yet must not sit frozen at
        // the start of the song; follow Spotify directly until a sync arrives.
        if ((!this._hasStdinLyrics || !this._syncSeen) && this._mpris) return this._mpris.getPositionMs();
        if (this._playbackStatus !== 'Playing') {
            return this._basePositionMs;
        }
        const nowUs = GLib.get_monotonic_time();
        const elapsedMs = (nowUs - this._baseTimeUs) / 1000;
        return this._basePositionMs + Math.max(0, elapsedMs) * this._playbackRate;
    }

    _findActiveIndex(posMs) {
        return activeLineIndex(this._lines, posMs);
    }

    _viewFrame(positionMs) {
        return floatingFrame(this._lines, positionMs, this._settings?.get_int('floating-line-count') ?? 2,
            this._settings?.get_boolean('show-countdown') ?? true);
    }

    _frameSignature(frame) {
        return `${frame.rows.map(row => `${row.id}:${row.state}`).join(',')}:${frame.filler?.startTimeMs ?? ''}:${frame.finished}`;
    }

    _render(cr, width, height) {
        // 1. Clear background transparently
        cr.save();
        cr.setOperator(Cairo.Operator.CLEAR);
        cr.paint();
        cr.restore();

        const currentPosMs = this._getCurrentPositionMs();
        const frame = this._viewFrame(currentPosMs);
        this._lastFrame = this._frameSignature(frame);
        const showCredits = this._showsCredits(frame);

        // Settings lookup with safe defaults
        const bgStyle = this._settings ? this._settings.get_string('background-style') : 'transparent';
        const fontFamily = this._settings ? this._settings.get_string('font-family') : 'Sans';
        const fontSize = this._settings ? this._settings.get_int('font-size') : 22;
        const lineSpacing = this._settings ? this._settings.get_int('line-spacing') : 14;
        const enableRomaji = this._settings ? this._settings.get_boolean('enable-romanization') : true;

        if (!frame.rows.length && !frame.filler && !showCredits) {
            this._rowMotion = null;
            this._lastDrawPosition = null;
            if (!this._pending) this._queueHeight(40);
            // Between songs there is nothing to grab; give the outline a label.
            if (this._moving()) this._drawMoveOutline(cr, width, height, 'Drag to move the lyrics');
            return;
        }

        // 2. Draw Background Card / Pill
        this._drawBackdrop(cr, width, height, bgStyle);

        const padX = 16;
        const textWidth = Math.max(80, width - padX * 2);
        let curY = 12;
        const targets = frame.rows.map(row => {
            const line = row.line;
            const alignment = lineAlignment(this._settings?.get_string('lyrics-alignment') || 'vocals', line);
            let rowHeight;
            if (row.kind === 'filler') rowHeight = Math.max(32, fontSize * 1.5);
            else {
                rowHeight = this._lineLayout(cr, line, fontFamily, fontSize, textWidth,
                    row.state === 'active').drawing.height;
                if (enableRomaji && line.romanized && line.romanized !== (line.words || line.text)) {
                    const layout = this._textLayout(cr, line.romanized,
                        `${fontFamily} Italic ${Math.max(12, Math.round(fontSize * 0.65))}`, textWidth, alignment);
                    rowHeight += 6 + layout.get_pixel_size()[1];
                }
            }
            const target = {id: row.id, row, y: curY, height: rowHeight,
                opacity: row.state === 'active' || row.kind === 'filler' ? 1 : row.state === 'past' ? 0.45 : 0.4};
            curY += rowHeight + Math.round(lineSpacing * 0.6);
            return target;
        });
        const now = GLib.get_monotonic_time() / 1000;
        this._rowMotion ||= new LyricRowMotion();
        const snap = !this._lastDrawPosition || Math.abs(currentPosMs - this._lastDrawPosition) > 1500;
        this._lastDrawPosition = currentPosMs;
        const geometry = targets.map(item => `${item.id}:${item.y}:${item.height}`).join('|');
        if (geometry !== this._motionGeometry) {
            this._motionGeometry = geometry;
            this._motionHeight = Math.max(this._contentHeight || curY, curY);
        }
        this._rowMotion.setRows(targets, now, snap);
        this._contentHeight = this._rowMotion.running(now) ? this._motionHeight : curY;
        const movingRows = this._rowMotion.sample(now);
        cr.save();
        // Old rows move out of the viewport rather than briefly replacing it.
        cr.rectangle(0, 4, width, Math.max(curY, ...movingRows.map(item => item.y + item.height), 40));
        cr.clip();
        for (const item of movingRows) {
            const {row, y, opacity} = item;
            if (row.kind === 'filler') {
                cr.pushGroup();
                this._drawCountdown(cr, row, currentPosMs, width, y, fontSize);
                cr.popGroupToSource();cr.paintWithAlpha(opacity);
                continue;
            }
            const line = row.line;
            const words = line.words || line.text || '';
            cr.pushGroup();
            const textHeight = this._drawKaraokeLine(cr, line, words, currentPosMs, fontFamily, fontSize,
                padX, y, textWidth, row.state === 'active');
            if (enableRomaji && line.romanized && line.romanized !== words)
                this._drawTextLine(cr, line.romanized,
                    `${fontFamily} Italic ${Math.max(12, Math.round(fontSize * 0.65))}`, padX, y + textHeight + 6,
                    [1, 1, 1, 0.8], textWidth,
                    lineAlignment(this._settings?.get_string('lyrics-alignment') || 'vocals', line));
            cr.popGroupToSource(); cr.paintWithAlpha(opacity);
        }
        cr.restore();
        // Keep the native window size stable while text scrolls. Resizing it
        // on every animation frame makes some compositors flash a blank frame.
        this._queueHeight(this._contentHeight + 10);
        if (this._moving()) this._drawMoveOutline(cr, width, height);
    }

    // Shows what can be dragged while Settings -> Move is active.
    _drawMoveOutline(cr, width, height, hint = null) {
        cr.save();
        cr.newPath();
        this._roundedRect(cr, 1.5, 1.5, width - 3, height - 3, 6);
        cr.setSourceRGBA(0.21, 0.52, 0.89, 0.18);
        cr.fillPreserve();
        cr.setSourceRGBA(0.47, 0.71, 1, 0.95);
        cr.setLineWidth(2);
        cr.setDash([6, 4], 0);
        cr.stroke();
        cr.restore();
        if (hint) this._drawTextLine(cr, hint, 'Sans 11', 16, Math.max(4, (height - 18) / 2), [1, 1, 1, 0.9],
            Math.max(80, width - 32), 'center');
    }

    _showsCredits(frame) {
        return Boolean(attributionMarkup(this._attribution) && (requiresVisibleAttribution(this._attribution)
            ? frame.rows.length : frame.ending));
    }

    _drawCountdown(cr, filler, positionMs, width, y, fontSize = 22) {
        const dots = countdownDots(filler, positionMs, this._settings?.get_boolean('animate-lyrics') ?? true);
        const alignment = lineAlignment(this._settings?.get_string('lyrics-alignment') || 'vocals', filler.line);
        const radius = Math.max(6, fontSize * 0.32);
        const step = radius * 3;
        const startX = alignment === 'left' ? 16 + radius : alignment === 'right' ? width - 16 - radius - step * 2 : width / 2 - step;
        dots.forEach((dot, index) => {
            const x = startX + index * step;
            const centerY = y + radius * 2 + 4 - dot.lift * radius;
            if (dot.lift > 0) {
                const glow = new Cairo.RadialGradient(x, centerY, radius * 0.6, x, centerY, radius * 2);
                glow.addColorStopRGBA(0, 1, 1, 1, dot.alpha * dot.lift * 0.35);
                glow.addColorStopRGBA(1, 1, 1, 1, 0);
                cr.setSource(glow);cr.newPath();cr.arc(x, centerY, radius * 2, 0, Math.PI * 2);cr.fill();
            }
            cr.newPath(); cr.arc(x, centerY, radius * (1 + dot.lift * 0.08), 0, Math.PI * 2);
            cr.setSourceRGBA(1, 1, 1, dot.alpha); cr.fill();
        });
    }

    _queueHeight(height) {
        if (this._creditsLabel?.visible) height += this._creditsLabel.measure(Gtk.Orientation.VERTICAL,
            Math.max(80, (this._drawingArea?.get_width() || 480) - 32))[1] + 12;
        const desired = Math.min(640, Math.max(56, Math.ceil(height)));
        if (!this._drawingArea || this._requestedHeight === desired) return;
        this._requestedHeight = desired;
        if (this._heightUpdateId) GLib.Source.remove(this._heightUpdateId);
        this._heightUpdateId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
            this._heightUpdateId = 0;
            this._drawingArea?.set_content_height(desired);
            this._win?.set_default_size(this._win.get_width() || 480, desired);
            return GLib.SOURCE_REMOVE;
        });
    }

    _setAttribution(attribution, expiresAt = null) {
        if (this._lyricsExpiryId) GLib.Source.remove(this._lyricsExpiryId);
        this._lyricsExpiryId = 0;
        this._attribution = attribution;
        this._creditsLabel?.set_markup(attributionMarkup(attribution));
        this._creditsLabel?.set_visible(false);
        if (Number.isFinite(expiresAt)) this._lyricsExpiryId = GLib.timeout_add(GLib.PRIORITY_DEFAULT,
            Math.max(1, Math.min(4294967295, expiresAt - Date.now())), () => {
                this._lyricsExpiryId = 0;
                this._lines = [];
                this._karaokeCache = null;
                this._karaokeLayouts = new Map();
                this._setAttribution(null);
                this._drawingArea?.queue_draw();
                if (!this._hasStdinLyrics && this._mpris) this._loadTrack(this._mpris.track);
                return GLib.SOURCE_REMOVE;
            });
    }

    _drawBackdrop(cr, w, h, style) {
        if (style === 'transparent') return;
        this._roundedRect(cr, 0, 0, w, h, 6);
        const alpha = style === 'dark-card' ? 0.92 : 0.65;
        cr.setSourceRGBA(0.06, 0.07, 0.09, alpha);
        cr.fill();
    }

    _roundedRect(cr, x, y, w, h, r) {
        cr.arc(x + r, y + r, r, Math.PI, 1.5 * Math.PI);
        cr.arc(x + w - r, y + r, r, 1.5 * Math.PI, 2 * Math.PI);
        cr.arc(x + w - r, y + h - r, r, 0, 0.5 * Math.PI);
        cr.arc(x + r, y + h - r, r, 0.5 * Math.PI, Math.PI);
        cr.closePath();
    }

    _lineLayout(cr, line, fontName, fontSize, width, active) {
        const animate = active && (this._settings?.get_boolean('animate-lyrics') ?? true);
        const alignment = lineAlignment(this._settings?.get_string?.('lyrics-alignment') || 'vocals', line);
        const weight = this._settings?.get_string?.('font-weight') || 'bold';
        const key = `${fontName}:${weight}:${fontSize}:${width}:${animate}:${alignment}`;
        this._karaokeLayouts ||= new Map();
        let cache = this._karaokeLayouts.get(line);
        if (cache?.key !== key) {
            cache = { line, key, drawing: new KaraokeLayout(cr,
                animate ? line : { ...line, syllables: null }, pangoFont(Pango, fontName, weight, fontSize),
                width, alignment) };
            this._karaokeLayouts.set(line, cache);
        }
        return cache;
    }

    _drawKaraokeLine(cr, line, text, posMs, fontName, fontSize, x, y, width, active = true) {
        const cache = this._lineLayout(cr, line, fontName, fontSize, width, active);
        if (active) this._karaokeCache = cache;
        return cache.drawing.draw(cr, posMs, x, y);
    }

    _textLayout(cr, text, fontString, width, alignment) {
        const layout = PangoCairo.create_layout(cr);
        layout.set_font_description(Pango.FontDescription.from_string(fontString));
        layout.set_text(text, -1);
        layout.set_width(Math.max(1, Math.floor(width)) * Pango.SCALE);
        layout.set_wrap(Pango.WrapMode.WORD_CHAR);
        layout.set_auto_dir(false);
        layout.set_alignment(({left:Pango.Alignment.LEFT,center:Pango.Alignment.CENTER,right:Pango.Alignment.RIGHT})[alignment]);
        return layout;
    }

    _drawTextLine(cr, text, fontString, x, y, rgba, width = 524, alignment = 'center') {
        const layout = this._textLayout(cr, text, fontString, width, alignment);
        cr.setSourceRGBA(...rgba);
        cr.moveTo(x, y);
        PangoCairo.show_layout(cr, layout);
        return layout.get_pixel_size()[1];
    }

    run(argv) {
        return this._app.run(argv || []);
    }
}

if (import.meta.url === Gio.File.new_for_path(System.programInvocationName).get_uri()) {
    const hud = new FloatingLyricsHUDApp();
    hud.run([System.programInvocationName]);
}
