#!/usr/bin/env -S gjs -m
/**
 * Spicie - Standalone Lyrics Window
 * High-performance 60 FPS millisecond karaoke overlay using GTK4, Cairo, and Pango.
 * Packaged and managed directly by the GNOME Shell Extension.
 */

import Gtk from 'gi://Gtk?version=4.0';
import Gdk from 'gi://Gdk?version=4.0';
import Pango from 'gi://Pango?version=1.0';
import PangoCairo from 'gi://PangoCairo?version=1.0';
import GLib from 'gi://GLib';
import Gio from 'gi://Gio';
import GioUnix from 'gi://GioUnix';
import Cairo from 'cairo';
import System from 'system';
import { KaraokeLayout } from '../karaokeLayout.js';
import { activeLineIndex } from '../karaokeTiming.js';

import { SpotifyMPRIS } from '../mpris.js';
import { LyricsProvider } from '../lyricsProvider.js';
import { lyricAttribution, attributionMarkup } from '../lyricsAttribution.js';
import { lineAlignment, activeVocalLines } from '../lyricsPresentation.js';

// Load X11 surface methods when available. Wayland-only GTK builds do not need
// this namespace; the extension hides their windows through the compositor.
try {
    imports.gi.versions.GdkX11 = '4.0';
    void imports.gi.GdkX11;
} catch (_) {}

export class FloatingLyricsHUDApp {
    constructor() {
        this._app = new Gtk.Application({
            application_id: 'dev.norang.SpotifyFloatingLyricsHUD',
            flags: Gio.ApplicationFlags.FLAGS_NONE,
        });

        this._win = null;
        this._drawingArea = null;
        this._settings = null;

        // Lyrics & playback state
        this._lines = [];
        this._currentLineIndex = -1;
        this._playbackStatus = 'Stopped';
        this._basePositionMs = 0;
        this._playbackRate = 1;
        this._baseTimeUs = GLib.get_monotonic_time();
        this._trackTitle = '';
        this._trackArtist = '';
        this._hasStdinLyrics = false;
        this._requestGeneration = 0;
        this._mpris = null;
        this._lyricsProvider = null;

        // Cached layouts for performance
        this._activeLayout = null;
        this._romajiLayout = null;
        this._nextLayout = null;

        this._setupSettings();
        this._app.connect('activate', () => this._onActivate());
        this._app.connect('shutdown', () => this._shutdown());
    }

    _setupSettings() {
        try {
            const schemaId = 'org.gnome.shell.extensions.spotify-floating-lyrics';
            const defaultSource = Gio.SettingsSchemaSource.get_default();
            const localPath = Gio.File.new_for_uri(import.meta.url).get_parent().get_parent().get_child('schemas').get_path();
            let schema = null;
            if (GLib.file_test(GLib.build_filenamev([localPath, 'gschemas.compiled']), GLib.FileTest.EXISTS)) {
                schema = Gio.SettingsSchemaSource.new_from_directory(localPath, defaultSource, false).lookup(schemaId, false);
            }
            schema ||= defaultSource.lookup(schemaId, true);

            if (schema) {
                this._settings = new Gio.Settings({ settings_schema: schema });
                const keys = [
                    'font-family',
                    'font-size',
                    'line-spacing',
                    'background-style',
                    'enable-romanization',
                    'floating-click-passthrough',
                    'animate-lyrics',
                    'lyrics-alignment',
                    'enable-spicy-lyrics',
                    'spicy-lyrics-token'
                ];
                keys.forEach(k => {
                    this._settings.connect(`changed::${k}`, () => {
                        this._onSettingsChanged();
                        if (['enable-spicy-lyrics', 'spicy-lyrics-token', 'enable-romanization'].includes(k) && !this._hasStdinLyrics && this._mpris) this._loadTrack(this._mpris.track);
                    });
                });
            }
        } catch (e) {
            console.error('[HUD] Settings init error:', e.message);
        }
    }

    _onActivate() {
        if (this._win) {
            this._win.present();
            return;
        }

        this._win = new Gtk.ApplicationWindow({
            application: this._app,
            title: 'Spicie',
            default_width: 480,
            default_height: 90,
            decorated: false,
        });
        this._win.connect('realize', () => {
            // X11 hints are applied before mapping. Wayland uses the extension's
            // compositor-side window-list control instead.
            const surface = this._win.get_surface();
            surface?.set_skip_taskbar_hint?.(true);
            surface?.set_skip_pager_hint?.(true);
        });

        // Set transparent window background via CSS
        const cssProvider = new Gtk.CssProvider();
        cssProvider.load_from_data(`
            window, .background {
                background-color: transparent;
                background: transparent;
            }
            .source-credits { color: rgba(255,255,255,0.85); font-size: 12px; }
            .source-credits link { color: #b4dcff; }
        `, -1);
        Gtk.StyleContext.add_provider_for_display(
            this._win.get_display(),
            cssProvider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        );

        // Drawing Area for 60 FPS sub-pixel karaoke rendering
        this._drawingArea = new Gtk.DrawingArea();
        this._drawingArea.set_draw_func((area, cr, width, height) => {
            this._render(cr, width, height);
        });

        // Use the display clock. Timing remains in milliseconds; repainting
        // follows the monitor refresh rather than a millisecond timer.
        this._drawingArea.add_tick_callback(() => {
            const index = this._findActiveIndex(this._getCurrentPositionMs());
            const animate = this._settings?.get_boolean('animate-lyrics') ?? true;
            const voices = activeVocalLines(this._lines, this._getCurrentPositionMs());
            const signature = voices.map(line => line.id ?? line.timeMs).join(',');
            const timed = voices.some(line => line.syllables?.length > 0);
            if (signature !== this._lastVoices || index !== this._lastDrawnIndex || (animate && timed && this._playbackStatus === 'Playing'))
                this._drawingArea.queue_draw();
            return true;
        });

        // Drag to move window
        const clickGesture = new Gtk.GestureClick({ button: 1 });
        clickGesture.connect('pressed', (gesture, nPress, x, y) => {
            const passthrough = this._settings ? this._settings.get_boolean('floating-click-passthrough') : false;
            if (passthrough) return;

            if (gesture.get_current_button() === 1) { // Left click
                const surface = this._win.get_surface();
                if (surface && typeof surface.begin_move === 'function') {
                    const device = gesture.get_device();
                    surface.begin_move(device, 1, x, y, gesture.get_current_event().get_time());
                }
            }
        });
        this._drawingArea.add_controller(clickGesture);

        const overlay = new Gtk.Overlay({ child: this._drawingArea });
        this._creditsLabel = new Gtk.Label({ use_markup: true, wrap: true,
            wrap_mode: Pango.WrapMode.WORD_CHAR, xalign: 0, halign: Gtk.Align.FILL,
            valign: Gtk.Align.END, margin_start: 16, margin_end: 16, margin_bottom: 8,
            css_classes: ['source-credits'], visible: false });
        overlay.add_overlay(this._creditsLabel);
        this._win.set_child(overlay);
        this._win.present();

        // Apply initial click passthrough
        this._applyClickPassthrough();

        // Start listening to stdin IPC
        this._startStdinReader();

        // Also attempt direct MPRIS fallback if running standalone
        this._initMPRISFallback();
    }

    _onSettingsChanged() {
        this._karaokeCache = null;
        this._karaokeLayouts = new Map();
        this._applyClickPassthrough();
        this._drawingArea?.set_cursor_from_name(this._settings?.get_boolean('floating-click-passthrough') ? 'default' : 'move');
        if (this._drawingArea) {
            this._drawingArea.queue_draw();
        }
    }

    _applyClickPassthrough() {
        if (!this._win) return;
        const surface = this._win.get_surface();
        if (!surface || typeof surface.set_input_region !== 'function') return;

        const passthrough = this._settings ? this._settings.get_boolean('floating-click-passthrough') : false;
        if (passthrough) {
            const emptyRegion = new Cairo.Region();
            surface.set_input_region(emptyRegion);
        } else {
            surface.set_input_region(null);
        }
    }

    _startStdinReader() {
        try {
            const stdinStream = new Gio.DataInputStream({
                base_stream: new GioUnix.InputStream({ fd: 0, close_fd: false })
            });

            const readNext = () => {
                stdinStream.read_line_async(GLib.PRIORITY_DEFAULT, null, (stream, res) => {
                    try {
                        const [line] = stream.read_line_finish_utf8(res);
                        if (line === null) {
                            // Extension exited or closed stdin -> cleanly exit HUD
                            if (this._hasStdinLyrics) this._app.quit();
                            return;
                        }
                        this._handleIPCMessage(line);
                        readNext();
                    } catch (e) {
                        this._app.quit();
                    }
                });
            };
            readNext();
        } catch (e) {
            console.error('[HUD] Stdin IPC init error:', e.message);
        }
    }

    _handleIPCMessage(rawJson) {
        try {
            const msg = JSON.parse(rawJson);
            if (!msg || !msg.type) return;
            if (!['lyrics', 'sync', 'exit'].includes(msg.type)) return;
            if (!this._hasStdinLyrics) this._lyricsProvider?.cancel();
            this._hasStdinLyrics = true;
            ++this._requestGeneration;

            switch (msg.type) {
                case 'lyrics':
                    this._lines = Array.isArray(msg.lines) ? msg.lines : [];
                    this._setAttribution(this._lines.length ? msg.attribution || {provider:'Unknown source',contributors:[]} : null, msg.expiresAt);
                    this._trackTitle = msg.title || '';
                    this._trackArtist = msg.artist || '';
                    this._currentLineIndex = -1;
                    this._karaokeCache = null;
                this._karaokeLayouts = new Map();
                    break;

                case 'sync':
                    this._playbackStatus = msg.status || 'Stopped';
                    this._basePositionMs = typeof msg.positionMs === 'number' ? msg.positionMs : 0;
                    this._baseTimeUs = Number.isFinite(msg.sampleTimeUs) ? msg.sampleTimeUs : GLib.get_monotonic_time();
                    this._playbackRate = Number(msg.rate) > 0 ? Number(msg.rate) : 1;
                    break;

                case 'exit':
                    this._app.quit();
                    break;
            }
            this._drawingArea?.queue_draw();
        } catch (e) {
            // Ignore malformed JSON line
        }
    }

    _initMPRISFallback() {
        this._requestGeneration = 0;
        this._mpris = new SpotifyMPRIS();
        this._lyricsProvider = new LyricsProvider();
        this._mpris.connect('track-changed', (_player, track) => {
            if (!this._hasStdinLyrics) this._loadTrack(track);
        });
        this._mpris.connect('status-changed', (_player, status) => {
            if (this._hasStdinLyrics) return;
            this._playbackStatus = status;
            this._drawingArea?.queue_draw();
        });
        this._mpris.connect('seeked', () => {
            if (!this._hasStdinLyrics) this._drawingArea?.queue_draw();
        });
        this._mpris.connect('player-available', (_player, available) => {
            if (!available && !this._hasStdinLyrics) this._loadTrack(null);
        });
        // Give the extension's initial messages a chance to arrive before
        // starting a second catalogue request in standalone mode.
        this._fallbackStart = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 150, () => {
            this._fallbackStart = 0;
            if (!this._hasStdinLyrics) this._loadTrack(this._mpris.track);
            return GLib.SOURCE_REMOVE;
        });
        this._clockRefresh = GLib.timeout_add(GLib.PRIORITY_DEFAULT, 2000, () => {
            if (!this._hasStdinLyrics) this._mpris.refreshPosition();
            return GLib.SOURCE_CONTINUE;
        });
    }

    async _loadTrack(track) {
        const generation = ++this._requestGeneration;
        this._lines = [];
        this._setAttribution(null);
        this._karaokeCache = null;
        this._karaokeLayouts = new Map();
        this._trackTitle = track?.title || '';
        this._trackArtist = track?.artist || '';
        this._playbackStatus = this._mpris.playbackStatus;
        this._drawingArea?.queue_draw();
        if (!track?.title) return;
        const enableRomanization = this._settings?.get_boolean('enable-romanization') ?? true;
        try {
            const result = await this._lyricsProvider.fetchLyrics(track.title, track.artist || '', track.album || '',
                Math.round((track.durationMs || 0) / 1000), track.trackId || '', {
                    enableSpicy: this._settings?.get_boolean('enable-spicy-lyrics') ?? false,
                    spicyToken: this._settings?.get_string('spicy-lyrics-token') || '', enableRomanization,
                });
            if (generation !== this._requestGeneration || this._hasStdinLyrics) return;
            this._lines = result.lines || [];
            this._setAttribution(lyricAttribution(result), result.expiresAt);
            this._drawingArea?.queue_draw();
        } catch (e) {
            if (generation === this._requestGeneration) console.warn(`[Lyrics] ${e.message}`);
        }
    }

    _shutdown() {
        ++this._requestGeneration;
        if (this._fallbackStart) GLib.Source.remove(this._fallbackStart);
        if (this._clockRefresh) GLib.Source.remove(this._clockRefresh);
        if (this._heightUpdateId) GLib.Source.remove(this._heightUpdateId);
        if (this._lyricsExpiryId) GLib.Source.remove(this._lyricsExpiryId);
        this._lyricsProvider?.destroy();
        this._mpris?.destroy();
        this._drawingArea = null;
        this._win = null;
    }

    _getCurrentPositionMs() {
        if (!this._hasStdinLyrics && this._mpris) return this._mpris.getPositionMs();
        if (this._playbackStatus !== 'Playing') {
            return this._basePositionMs;
        }
        const nowUs = GLib.get_monotonic_time();
        const elapsedMs = (nowUs - this._baseTimeUs) / 1000;
        return this._basePositionMs + Math.max(0, elapsedMs) * this._playbackRate;
    }

    _findActiveIndex(posMs) {
        return activeLineIndex(this._lines, posMs);
    }

    _render(cr, width, height) {
        // 1. Clear background transparently
        cr.save();
        cr.setOperator(Cairo.Operator.CLEAR);
        cr.paint();
        cr.restore();

        const currentPosMs = this._getCurrentPositionMs();
        const activeIdx = this._findActiveIndex(currentPosMs);
        const voices = activeVocalLines(this._lines, currentPosMs);
        const activeLine = voices[0] || null;
        this._lastVoices = voices.map(line => line.id ?? line.timeMs).join(',');
        this._creditsLabel?.set_visible(Boolean(activeLine && this._attribution));
        this._lastDrawnIndex = activeIdx;

        // Settings lookup with safe defaults
        const bgStyle = this._settings ? this._settings.get_string('background-style') : 'transparent';
        const fontFamily = this._settings ? this._settings.get_string('font-family') : 'Sans';
        const fontSize = this._settings ? this._settings.get_int('font-size') : 22;
        const lineSpacing = this._settings ? this._settings.get_int('line-spacing') : 14;
        const enableRomaji = this._settings ? this._settings.get_boolean('enable-romanization') : true;

        // 2. Draw Background Card / Pill
        this._drawBackdrop(cr, width, height, bgStyle);

        // 3. Render Content
        const padX = 16;
        let curY = 12;

        if (!activeLine) {
            this._queueHeight(40);
            return;
        }

        for (const line of voices) {
            const words = line.words || line.text || '';
            const alignment = lineAlignment(this._settings?.get_string('lyrics-alignment') || 'vocals', line);
            curY += this._drawKaraokeLine(cr, line, words, currentPosMs, fontFamily, fontSize,
                padX, curY, Math.max(80, width - padX * 2));
            if (enableRomaji && line.romanized && line.romanized !== words) {
                curY += 6 + this._drawTextLine(cr, line.romanized,
                    `${fontFamily} Italic ${Math.max(12, Math.round(fontSize * 0.65))}`, padX, curY + 6,
                    [1, 1, 1, 0.8], width - padX * 2, alignment);
            }
            curY += Math.round(lineSpacing * 0.6);
        }
        this._queueHeight(curY + 10);
    }

    _queueHeight(height) {
        if (this._creditsLabel?.visible) height += this._creditsLabel.measure(Gtk.Orientation.VERTICAL,
            Math.max(80, (this._drawingArea?.get_width() || 480) - 32))[1] + 12;
        const desired = Math.min(640, Math.max(56, Math.ceil(height)));
        if (!this._drawingArea || this._requestedHeight === desired) return;
        this._requestedHeight = desired;
        if (this._heightUpdateId) GLib.Source.remove(this._heightUpdateId);
        this._heightUpdateId = GLib.idle_add(GLib.PRIORITY_DEFAULT_IDLE, () => {
            this._heightUpdateId = 0;
            this._drawingArea?.set_content_height(desired);
            this._win?.set_default_size(this._win.get_width() || 480, desired);
            return GLib.SOURCE_REMOVE;
        });
    }

    _setAttribution(attribution, expiresAt = null) {
        if (this._lyricsExpiryId) GLib.Source.remove(this._lyricsExpiryId);
        this._lyricsExpiryId = 0;
        this._attribution = attribution;
        this._creditsLabel?.set_markup(attributionMarkup(attribution));
        this._creditsLabel?.set_visible(Boolean(attribution && this._lines.length));
        if (Number.isFinite(expiresAt)) this._lyricsExpiryId = GLib.timeout_add(GLib.PRIORITY_DEFAULT,
            Math.max(1, Math.min(4294967295, expiresAt - Date.now())), () => {
                this._lyricsExpiryId = 0;
                this._lines = [];
                this._karaokeCache = null;
                this._karaokeLayouts = new Map();
                this._setAttribution(null);
                this._drawingArea?.queue_draw();
                if (!this._hasStdinLyrics && this._mpris) this._loadTrack(this._mpris.track);
                return GLib.SOURCE_REMOVE;
            });
    }

    _drawBackdrop(cr, w, h, style) {
        if (style === 'transparent') return;
        this._roundedRect(cr, 0, 0, w, h, 6);
        const alpha = style === 'dark-card' ? 0.92 : 0.65;
        cr.setSourceRGBA(0.06, 0.07, 0.09, alpha);
        cr.fill();
    }

    _roundedRect(cr, x, y, w, h, r) {
        cr.arc(x + r, y + r, r, Math.PI, 1.5 * Math.PI);
        cr.arc(x + w - r, y + r, r, 1.5 * Math.PI, 2 * Math.PI);
        cr.arc(x + w - r, y + h - r, r, 0, 0.5 * Math.PI);
        cr.arc(x + r, y + h - r, r, 0.5 * Math.PI, Math.PI);
        cr.closePath();
    }

    _drawKaraokeLine(cr, line, text, posMs, fontName, fontSize, x, y, width) {
        const animate = this._settings?.get_boolean('animate-lyrics') ?? true;
        const alignment = lineAlignment(this._settings?.get_string?.('lyrics-alignment') || 'vocals', line);
        const key = `${fontName}:${fontSize}:${width}:${animate}:${alignment}`;
        this._karaokeLayouts ||= new Map();
        let cache = this._karaokeLayouts.get(line);
        if (cache?.key !== key) {
            cache = { line, key, drawing: new KaraokeLayout(cr,
                animate ? line : { ...line, syllables: null }, `${fontName} Bold ${fontSize}`, width, alignment) };
            this._karaokeLayouts.set(line, cache);
        }
        this._karaokeCache = cache;
        return this._karaokeCache.drawing.draw(cr, posMs, x, y);
    }

    _drawTextLine(cr, text, fontString, x, y, rgba, width = 524, alignment = 'center') {
        const layout = PangoCairo.create_layout(cr);
        const fontDesc = Pango.FontDescription.from_string(fontString);
        layout.set_font_description(fontDesc);
        layout.set_text(text, -1);
        layout.set_width(Math.max(1, Math.floor(width)) * Pango.SCALE);
        layout.set_wrap(Pango.WrapMode.WORD_CHAR);
        layout.set_auto_dir(false);
        layout.set_alignment(({left:Pango.Alignment.LEFT,center:Pango.Alignment.CENTER,right:Pango.Alignment.RIGHT})[alignment]);
        const [textW, textH] = layout.get_pixel_size();

        cr.setSourceRGBA(rgba[0], rgba[1], rgba[2], rgba[3]);
        cr.moveTo(x, y);
        PangoCairo.show_layout(cr, layout);
        return textH;
    }

    run(argv) {
        return this._app.run(argv || []);
    }
}

if (import.meta.url === Gio.File.new_for_path(System.programInvocationName).get_uri()) {
    const hud = new FloatingLyricsHUDApp();
    hud.run([System.programInvocationName]);
}
